{
  "displayName": "RustGL (Gurkha build)",
  "rendererId": "opengles3",
  "rendererGLPath": "**|librustgl.so",
  "rendererEGLPath": "**|librustgl.so",
  "dlopenLibPaths": [],
  "env": [
    {
      "type": "NormalEnv",
      "key": "LIBGL_ES",
      "value": "3"
